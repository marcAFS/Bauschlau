# Bau-Schlau – Umgebungsvariablen
# Kopiere diese Datei zu ".env" und trage deine eigenen Werte ein:
#   cp .env.example .env

# Verbindung zu deiner PostgreSQL-Datenbank (z. B. von Neon, Vercel Postgres
# oder Supabase). Beispiel-Format:
# postgresql://USER:PASSWORT@HOST:5432/DATENBANK?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/bauschlau?sslmode=require"

# Login-Schutz der App (siehe /login): E-Mail + Passwort, beides frei wählbar.
APP_EMAIL="deine@email.de"
APP_PASSWORD="change-me"

# Geheimer Schlüssel zum Signieren der Login-Session. Mit folgendem Befehl
# kannst du dir einen zufälligen Wert erzeugen:
#   openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"
